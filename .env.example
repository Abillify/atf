# ATF — minimal Runtime configuration for local development.
#
# This is a starting point, not a complete list. Runtime accepts 264 variables; every one is
# documented in docs/CONFIGURATION.md, generated from the schema itself. Per-service templates
# live next to each application:
#
#   apps/runtime/.env.example
#   apps/search/.env.example
#   apps/gate/.env.example
#   apps/control/.env.example
#
# For a running four-service stack, prefer deploy/examples/ over this file.
# Never put real credentials in a committed file. Use a secret manager.

# --- Process -----------------------------------------------------------------
PORT=3000
APP_ENV=development
LOG_LEVEL=info
FLOWS_DIR=./deploy/examples/flows

# --- Security ----------------------------------------------------------------
# Development values only. See the production notes in DEPLOYMENT.md before deploying:
# with APP_ENV=production, Runtime refuses to start with these settings.
AUTHN_MODE=disabled
AUTHZ_ENABLED=false
TENANT_ISOLATION_ENABLED=false
MONITORING_AUTH=false
METRICS_AUTH=false
CORS_ORIGINS=http://localhost:3001

# --- Models ------------------------------------------------------------------
# Named inference endpoints are the only provider source. Every model setting references a
# provider by its `name`, never by protocol. Runtime validates all references at startup.
# Protocols: openai | google | anthropic | azure | bedrock | ollama
PROVIDERS=[{"name":"local","protocol":"openai","url":"http://127.0.0.1:1234/v1","local":true}]
DEFAULT_LLM={"provider":"local","model":"CHANGE_ME"}
# FALLBACK_LLM={"provider":"another-provider","model":"CHANGE_ME"}

# --- Optional state ----------------------------------------------------------
# Without PostgreSQL, Runtime keeps cost, audit, jobs, and approvals in memory per replica.
# DATABASE_URL=postgres://CHANGE_ME
# DATABASE_OPERATOR_URL=postgres://CHANGE_ME
#
# Redis is only needed when multiple replicas must share approvals, rate limits, or budgets.
# REDIS_URL=redis://127.0.0.1:6379

# --- Frequently used features ------------------------------------------------
# All default to off. See docs/CAPABILITIES.md for what each one does.
# APPROVAL_GATE_ENABLED=true
# INPUT_GUARDRAILS_ENABLED=true
# OUTPUT_GUARDRAILS_ENABLED=true
# PII_VAULT_ENABLED=true
# RAG_ENABLED=true
# TRACING_ENABLED=true
# METRICS_ENABLED=true

# --- Secrets -----------------------------------------------------------------
# Required once the corresponding feature is enabled. Generate with:
#   openssl rand -hex 32
# JWT_SECRET=CHANGE_ME
# AUDIT_ANCHOR_SECRET=CHANGE_ME
# EVIDENCE_BUNDLE_SECRET=CHANGE_ME
# PII_VAULT_ENCRYPTION_KEY=CHANGE_ME
# BYOK_ENCRYPTION_KEY=CHANGE_ME
