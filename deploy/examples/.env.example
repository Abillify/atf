# Optional host-port overrides. No credentials are required by this local-only stack.
ATF_RUNTIME_PORT=3000
ATF_CONTROL_PORT=3001
ATF_SEARCH_PORT=3002
ATF_GATE_PORT=3003
ATF_EXTRACT_PORT=3004

# Product version of the published images `compose.images.yaml` pulls
# (ghcr.io/abillify/atf-<service>:<version>). Kept in step with the root
# package.json by `bun run version:sync`; only the image-based variant reads it.
ATF_VERSION=0.25.6
