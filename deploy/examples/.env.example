# Optional host-port overrides. No credentials are required by this local-only stack.
ATF_RUNTIME_PORT=3000
ATF_CONTROL_PORT=3001
ATF_SEARCH_PORT=3002
ATF_GATE_PORT=3003
ATF_EXTRACT_PORT=3004

# Product version of the published images `compose.images.yaml` pulls
# (ghcr.io/abillify/atf-<service>:<version>). Kept in step with the root
# package.json by `bun run version:sync`; only the image-based variant reads it.
ATF_VERSION=0.26.0

# How long an unanswered approval request stays open before the Runtime treats the silence as
# a rejection. The stack itself defaults to 600000 (ten minutes), which is what the tool-use
# walkthrough in README.md needs while it is being read. Step 2 of TOUR.md demonstrates that
# same rule ending in a rejection, which wants the opposite, so it starts the stack with a
# short window instead of asking anyone to edit compose.yaml:
#   ATF_APPROVAL_TIMEOUT_MS=15000 docker compose --env-file .env.example -f compose.yaml up -d
ATF_APPROVAL_TIMEOUT_MS=600000
