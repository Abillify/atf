# syntax=docker/dockerfile:1
# Production image for the ATF runtime (requirements 12.1, 12.2).
#
# Multi-stage: dependencies are installed with --production only and scoped to
# this workspace via --filter, the final stage is the official Bun distroless
# image pinned by digest, running as the non-root UID 65532. The root
# filesystem can be mounted read-only; mount a tmpfs at /tmp only if a flow
# writes scratch files.
#
# Build from the repository root:
#   docker build -f deploy/images/Dockerfile.runtime -t atf-runtime .
#
# Digests are updated by Dependabot (docker ecosystem).
FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS deps
WORKDIR /repo
# .dockerignore excludes node_modules, dist, .next and test artifacts, so the
# context stays small even though this is a monorepo.
COPY . .
# Production dependencies only, scoped to the runtime and the @atf/* workspace
# packages it imports (Bun follows workspace dependencies transitively). The
# hoisted node_modules layout is kept so the app resolves @atf/* through the
# workspace symlinks in the final stage.
RUN bun install --frozen-lockfile --production --filter @atf/runtime

# The distroless base carries glibc but not the C++ ABI libraries that the
# lazily imported NER stack (@huggingface/transformers -> onnxruntime-node,
# sharp) links against. Stage them here (cp -L resolves the versioned
# symlinks) so the final stage can pick them up without a shell.
RUN mkdir -p /native-libs \
    && cp -L /usr/lib/*/libstdc++.so.6 /usr/lib/*/libgcc_s.so.1 /native-libs/

FROM oven/bun:1.4.4-distroless@sha256:153a951ae40106e125898103e6e990ee0f38e6aee7f561029e26cf9fbed23470 AS runtime
ENV NODE_ENV=production
WORKDIR /app
# C++ ABI runtime libraries for onnxruntime-node/sharp (see deps stage).
# /usr/lib is on the dynamic loader's default search path.
COPY --from=deps /native-libs/ /usr/lib/
# The workspace symlinks under node_modules/@atf point at ../../packages/...,
# so the package sources must ship next to node_modules. apps/runtime is the
# only app source needed; flows are mounted via FLOWS_DIR, not baked in.
COPY --from=deps --chown=65532:65532 /repo/package.json /repo/bun.lock /app/
COPY --from=deps --chown=65532:65532 /repo/node_modules /app/node_modules
COPY --from=deps --chown=65532:65532 /repo/packages /app/packages
COPY --from=deps --chown=65532:65532 /repo/apps/runtime /app/apps/runtime
USER 65532:65532
EXPOSE 3000
# The entry file is invoked directly, not through the `start` package.json
# script: Bun's script runner needs a /bin/sh, which the distroless base does
# not ship. Import resolution still walks up to the hoisted /app/node_modules.
WORKDIR /app/apps/runtime
ENTRYPOINT ["/usr/local/bin/bun", "run", "src/index.ts"]
