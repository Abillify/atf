# syntax=docker/dockerfile:1
# Production image for the ATF gate service (requirements 12.1, 12.2).
#
# Multi-stage: dependencies are installed with --production only and scoped to
# this workspace via --filter, the final stage is the official Bun distroless
# image pinned by digest, running as the non-root UID 65532. The root
# filesystem can be mounted read-only; the gate reads its configuration from
# MCPGATE_CONFIG_DIR, which is mounted, never written to.
#
# Build from the repository root:
#   docker build -f deploy/images/Dockerfile.gate -t atf-gate .
#
# Digests are updated by Dependabot (docker ecosystem).
FROM oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS deps
WORKDIR /repo
# .dockerignore excludes node_modules, dist, .next and test artifacts, so the
# context stays small even though this is a monorepo.
COPY . .
# Production dependencies only, scoped to the gate and the @atf/* workspace
# packages it imports (Bun follows workspace dependencies transitively).
# Optional database drivers (sqlite3, oracledb, tedious, mysql, mariadb) are
# declared as peer/optional dependencies and stay absent unless an operator
# adds them; the gate degrades gracefully for the missing connectors.
RUN bun install --frozen-lockfile --production --filter @atf/gate

FROM oven/bun:1.4.2-distroless@sha256:1a0c31c7c5f9d193aedf60fe1cebdeb76ac8f6e29f24be8dd8cbd6df72df26ec AS runtime
ENV NODE_ENV=production
WORKDIR /app
# The workspace symlinks under node_modules/@atf point at ../../packages/...,
# so the package sources must ship next to node_modules. Gate configuration is
# mounted at MCPGATE_CONFIG_DIR, not baked in.
COPY --from=deps --chown=65532:65532 /repo/package.json /repo/bun.lock /app/
COPY --from=deps --chown=65532:65532 /repo/node_modules /app/node_modules
COPY --from=deps --chown=65532:65532 /repo/packages /app/packages
COPY --from=deps --chown=65532:65532 /repo/apps/gate /app/apps/gate
USER 65532:65532
EXPOSE 3000
# The entry file is invoked directly, not through the `start` package.json
# script: Bun's script runner needs a /bin/sh, which the distroless base does
# not ship. Import resolution still walks up to the hoisted /app/node_modules.
WORKDIR /app/apps/gate
ENTRYPOINT ["/usr/local/bin/bun", "run", "src/index.ts"]
