  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth2/OIDC access token validated by the configured authenticator (auth.mode oauth|both)."
      },
      "serviceAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "service-token",
        "description": "Internal service credential used by the orchestrator for the shared erasure contract."
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "atf_monitor_session",
        "description": "Operator browser session established via /monitor/login (OIDC BFF)."
      },
      "webhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Hub-Signature-256",
        "description": "HMAC request signature verified against the webhook tool's secret."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
