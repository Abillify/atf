{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-node",
      "!**/.next",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.snap",
      "!**/bun.lock",
      "!sbom.cdx.json",
      "!THIRD_PARTY_NOTICES.md",
      "!docs/CONFIGURATION.md",
      "!deploy/helm/**/templates",
      "!licenses",
      "!biome-report.json"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true
  },
  "formatter": {
    "enabled": true
  },
  "overrides": [
    {
      "includes": [
        "apps/control/src/components/**",
        "apps/control/src/app/**",
        "!apps/control/src/app/api/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Direct fetch calls are only allowed in lib/control-api (Req 9.2)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ]
}
