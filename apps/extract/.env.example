# @atf/extract — document-to-Markdown extraction against the atf-extract contract.
#
# Complete reference: docs/CONFIGURATION.md (generated from src/config.ts).
# Extract has its own environment contract. Names that also exist in Search or Runtime
# are NOT shared — except the access block below, which is deliberately identical so
# SSO is configured once for the whole fabric.

PORT=3004
NODE_ENV=development
LOG_LEVEL=info
# Needed for OIDC redirects when running behind a reverse proxy.
# PUBLIC_URL=https://extract.example

# --- Required: vision model ---------------------------------------------------
# Base URL of an OpenAI-compatible server; /v1/chat/completions is appended.
VISION_URL=http://127.0.0.1:8000
VISION_MODEL=CHANGE_ME
# Optional: a self-hosted vLLM on a cluster network commonly has no auth.
# VISION_API_KEY=CHANGE_ME

# --- Vision behaviour ---------------------------------------------------------
# Per page. A dense A4 page on a local 27B vision model takes minutes; 0 disables.
# VISION_TIMEOUT_MS=600000
# VISION_TEMPERATURE=0.1
# VISION_TOP_P=1.0
# Escalating output budgets, tried in order when the model stops on "length".
# A truncated page is a silently corrupted page.
# VISION_MAX_TOKEN_VARIANTS=8192,16384,32768
# VISION_MAX_RETRIES=3
# Forwarded as chat_template_kwargs.reasoning_effort; unset means not sent.
# VISION_REASONING_EFFORT=low
# USD per million tokens, for cost reporting only.
# VISION_INPUT_TOKEN_COST=0.15
# VISION_OUTPUT_TOKEN_COST=0.6

# --- Rendering ----------------------------------------------------------------
# Resolution the page is rasterised at for the model. Below 200 small table text
# stops being legible; above it the image cost grows without better transcription.
# RENDER_DPI=200
# Figure crops are rendered higher: they are shown to a human in a search result.
# Must be >= RENDER_DPI.
# FIGURE_DPI=300
# PAGE_LABEL=Seite
# TEMP_DIR=/tmp/atf-extract
# LIBREOFFICE_BIN=libreoffice
# POPPLER_BIN_DIR=/usr/bin

# --- Limits -------------------------------------------------------------------
# MAX_UPLOAD_BYTES=52428800
# Production requires a page ceiling: without one a single upload can spend
# model tokens without bound.
MAX_PAGES=200
# CONVERT_CONCURRENCY=2
# PAGE_CONCURRENCY=4
# QUEUE_MAX_DEPTH=32
# BODY_LIMIT=1mb
# RATE_LIMIT=120
# CALLBACK_MAX_RETRIES=3
# CALLBACK_TIMEOUT_MS=30000
# X-Callback-URL makes this service issue a request to a caller-chosen address —
# a blind SSRF primitive. Link-local and metadata addresses are always refused;
# list the hosts your orchestrator actually uses to close the rest.
# An entry beginning with a dot matches any subdomain.
CALLBACK_ALLOWED_HOSTS=.svc.cluster.local,127.0.0.1

# --- Search ingest (opt-in) ---------------------------------------------------
# Without SEARCH_URL the /v1/ingest route is not mounted at all.
# SEARCH_URL=http://127.0.0.1:3002
# SEARCH_TOKEN=CHANGE_ME
# SEARCH_COLLECTION=documents
# SEARCH_TIMEOUT_MS=120000
# SEARCH_UPLOAD_ASSETS=true

# --- Access -------------------------------------------------------------------
# The development default is deliberately open. The production readiness gate
# refuses to start with these values when NODE_ENV=production.
AUTHN_MODE=disabled
AUTHZ_ENABLED=false
TENANT_ISOLATION_ENABLED=false
# API_TOKEN=CHANGE_ME
# API_SERVICE_SCOPES=extract.convert,extract.ingest,extract.metrics,extract.admin
# API_SERVICE_TENANT_ID=default
# API_OIDC_ISSUERS=[{"issuer":"https://issuer.example","audience":"atf-extract","scopesClaim":"scopes","tenantClaim":"tenant"}]
# DEFAULT_TENANT_ID=default
# TRUST_PROXY=false
# EXPOSE_ERROR_DETAIL=false

# --- Browser SSO (opt-in via OIDC_ISSUER) -------------------------------------
# Same shape as Search, so one IdP client can serve both.
# OIDC_ISSUER=https://issuer.example/application/o/atf/
# OIDC_CLIENT_ID=CHANGE_ME
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_SESSION_SECRET=CHANGE_ME_at_least_16_chars
# OIDC_SCOPES=openid profile email
# OIDC_REDIRECT_URI=https://extract.example/auth/callback
# Either or both may be set; a session is accepted when it matches one of them.
# Leaving both unset admits every account the IdP authenticates.
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# OIDC_ALLOWED_EMAILS=operator@example.com
# OIDC_GROUPS_CLAIM=groups
# OIDC_SESSION_TTL=28800
# MONITOR_TOKEN=CHANGE_ME

# --- UI backend-for-frontend --------------------------------------------------
# The UI never derives tenant or scopes from the ID token; the server picks them.
# UI_TENANT_ID=default
# UI_SCOPES=extract.convert,extract.ingest
# UI_ALLOWED_GROUPS=atf-operators
# UI_OPERATOR_GROUP=atf-operators
