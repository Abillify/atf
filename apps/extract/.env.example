# @atf/extract — document-to-Markdown extraction against the atf-extract contract.
#
# Complete reference: docs/CONFIGURATION.md (generated from src/config.ts).
# Extract has its own environment contract. Names that also exist in Search or Runtime
# are NOT shared — except the access block below, which is deliberately identical so
# SSO is configured once for the whole fabric.

PORT=3004
NODE_ENV=development
LOG_LEVEL=info
# OTel span export via the shared @atf/observability tracer (log-only without
# an endpoint).
# TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=atf-extract
# Needed for OIDC redirects when running behind a reverse proxy.
# PUBLIC_URL=https://extract.example

# --- Required: vision model ---------------------------------------------------
# Base URL of an OpenAI-compatible server; /v1/chat/completions is appended.
VISION_URL=http://127.0.0.1:8000
VISION_MODEL=CHANGE_ME
# Optional: a self-hosted vLLM on a cluster network commonly has no auth.
# VISION_API_KEY=CHANGE_ME

# --- Vision behaviour ---------------------------------------------------------
# Per page. A dense A4 page on a local 27B vision model takes minutes; 0 disables.
# VISION_TIMEOUT_MS=600000
# VISION_TEMPERATURE=0.1
# VISION_TOP_P=1.0
# Escalating output budgets, tried in order when the model stops on "length".
# A truncated page is a silently corrupted page.
# VISION_MAX_TOKEN_VARIANTS=8192,16384,32768
# VISION_MAX_RETRIES=3
# Forwarded as chat_template_kwargs.reasoning_effort; unset means not sent.
# VISION_REASONING_EFFORT=low
# Capability flag: send response_format json_schema with VLM requests so the
# provider enforces the output schema (Pass 1 page + Pass 2 transcriptions).
# Off by default — a provider that does not understand the field rejects the
# request; the client then drops the field and continues unstructured.
# VISION_SUPPORTS_JSON_SCHEMA=false
# USD per million tokens, for cost reporting only.
# VISION_INPUT_TOKEN_COST=0.15
# VISION_OUTPUT_TOKEN_COST=0.6

# --- Rendering ----------------------------------------------------------------
# Resolution the page is rasterised at for the model. Below 200 small table text
# stops being legible; above it the image cost grows without better transcription.
# RENDER_DPI=200
# Figure crops are rendered higher: they are shown to a human in a search result.
# Must be >= RENDER_DPI.
# FIGURE_DPI=300
# Hard pixel ceiling on a POST /v2/render response (on-demand zoom/full-res).
# A large targetPixels or a poster-sized crop is clamped DOWN to this, so one
# request can never allocate a gigapixel buffer.
# RENDER_MAX_PIXELS=40000000
# Requests/min/IP for POST /v2/render, on top of auth. Each render spawns a
# poppler subprocess, so a zoom burst is CPU; a research session issues many
# small renders, so the default is higher than RATE_LIMIT. 0 disables it.
# RENDER_RATE_LIMIT=240
# PAGE_LABEL=Seite
# TEMP_DIR=/tmp/atf-extract
# LIBREOFFICE_BIN=libreoffice
# POPPLER_BIN_DIR=/usr/bin
# Wall-clock ceiling on each poppler/LibreOffice call, so one hung page cannot
# stall a PAGE_CONCURRENCY slot forever. 0 disables it; the production gate
# refuses to start with 0.
# SUBPROCESS_TIMEOUT_MS=120000
# Kernel limits per converter call via prlimit (Linux only, when prlimit is
# installed). --as caps virtual memory, which LibreOffice reserves generously:
# in a container leave it at 0 and use the cgroup memory limit instead.
# --cpu is a CPU-second ceiling with SIGKILL on breach. 0 disables either.
# SUBPROCESS_MEMORY_LIMIT_MB=0
# SUBPROCESS_CPU_LIMIT_S=900
# Where converter binaries run. local spawns them in this process; isolated
# forwards every call over a Unix socket to a separate converter process
# (node dist/converter/server.js) that mounts the same TEMP_DIR at the same
# path. The socket has no authentication; only the two processes may reach it.
# CONVERTER_MODE=local
# CONVERTER_SOCKET=/run/atf-converter/converter.sock
# CONVERTER_MODE=local is fatal in production (HTML pages decide what the
# in-process LibreOffice loads). Run isolated, or acknowledge the risk:
# CONVERTER_ALLOW_LOCAL_HTML=true
# Converted PDFs are cached under TEMP_DIR/derived-pdf. Least recently used
# entries go when the cache exceeds MAX_MB or an entry is unused for MAX_AGE_HOURS
# (0 = unlimited); a PDF a running job holds is never evicted.
# DERIVED_PDF_CACHE_MAX_MB=2048
# DERIVED_PDF_CACHE_MAX_AGE_HOURS=168
# OCR fallback for scanned pages while the vision model is down: off fails the
# page for a later retry, tesseract recognises it and records a page warning.
# The binary and the traineddata for every OCR_LANG entry must be installed.
# OCR_FALLBACK=off
# TESSERACT_BIN=tesseract
# OCR_LANG=deu

# --- Hostile-document limits --------------------------------------------------
# ZIP-based containers (XLSX, VSDX, DOCX, PPTX, DOCX embeddings) are checked
# against these before anything is inflated; a violation is
# DOCUMENT_TOO_COMPLEX (422).
# ZIP_MAX_ENTRIES=10000
# ZIP_MAX_TOTAL_BYTES=536870912
# ZIP_MAX_ENTRY_BYTES=209715200
# ZIP_MAX_RATIO=100
# Deeper embedded .msg messages are skipped with a warning.
# MAX_EMBED_DEPTH=2
# Native parsers run in a Worker thread with this heap ceiling (enforced by
# Node, ignored by Bun); a breach fails with DOCUMENT_TOO_COMPLEX.
# PARSE_ISOLATED=true
# PARSE_MEMORY_LIMIT_MB=512

# --- Limits -------------------------------------------------------------------
# MAX_UPLOAD_BYTES=52428800
# Uploads above this many bytes are spooled to a scratch file under
# TEMP_DIR/uploads instead of being held in the heap while they wait in the
# conversion queue (requirement 5.9). The scratch file is removed when the
# job is done; a crash is covered by a sweep at the next start. 0 spools
# every upload to disk.
# UPLOAD_MEMORY_THRESHOLD_BYTES=8388608
# Page ceiling per document: without one a single upload can spend model
# tokens without bound. Default 500; 0 disables the cap.
MAX_PAGES=200
# VLM pages a single tenant may spend per UTC day across ALL of its jobs
# (requirement 5.8). Over the cap, jobs fail with BUDGET_EXCEEDED until the
# next UTC day. 0 disables it — the prod gate warns about that, because the
# per-job token budget caps one job but not a tenant running many.
# VISION_BUDGET_PAGES_PER_DAY=2000
# Retention. Finished jobs keep the persisted model response of every page; 0
# keeps them forever (the prod gate warns). Abandoned resumable uploads are
# removed after UPLOAD_SESSION_MAX_AGE_HOURS (0 = keep). Source bytes leave with
# DELETE /v2/documents or an erasure, never by age (/v2/render needs them).
# JOB_RETENTION_DAYS=30
# UPLOAD_SESSION_MAX_AGE_HOURS=72
# RETENTION_SWEEP_INTERVAL_MINUTES=60
# CONVERT_CONCURRENCY=2
# PAGE_CONCURRENCY=4
# QUEUE_MAX_DEPTH=32
# BODY_LIMIT=1mb
# RATE_LIMIT=120
# Running more than one replica? The rate-limit budget is per replica unless
# every replica shares one Redis. Declare the replica count and the Redis URL;
# REPLICAS>1 without RATE_LIMIT_REDIS_URL fails the production gate (ADR 0031).
# REPLICAS=1
# RATE_LIMIT_REDIS_URL=redis://redis:6379
# CALLBACK_MAX_RETRIES=3
# CALLBACK_TIMEOUT_MS=30000
# X-Callback-URL makes this service issue a request to a caller-chosen address —
# a blind SSRF primitive. Link-local and metadata addresses are always refused.
# Left empty, only public addresses are reachable: private and loopback receivers
# are refused, so an internal orchestrator must be listed here. A listed host may
# resolve to private space. An entry beginning with a dot matches any subdomain.
CALLBACK_ALLOWED_HOSTS=.svc.cluster.local,127.0.0.1

# --- Persistence (opt-in) -----------------------------------------------------
# Enables the persistent, resumable v2 job model. All objects live in a
# dedicated `extract` schema on the given Postgres. Without EXTRACT_DATABASE_URL
# the service stays database-free and only the v1 synchronous paths are served;
# the persistence layer is initialised lazily the first time a v2 job needs it.
# EXTRACT_DATABASE_URL=postgres://extract:CHANGE_ME@127.0.0.1:5432/atf
# EXTRACT_DB_POOL_MAX=10
# EXTRACT_DB_STATEMENT_TIMEOUT_MS=30000

# --- Job worker (v2) ----------------------------------------------------------
# A worker claims jobs from the extract.jobs queue, holds a lease it renews on a
# heartbeat, and fences every write on the lease epoch so a partitioned worker
# cannot overwrite a job another worker has taken over. The heartbeat interval
# must be well below the lease so a healthy worker never loses its own lease; an
# expired lease is taken over by whoever claims next. JOB_MAX_TRANSIENT_WAIT_MS
# is how long a dependency (vision, text LLM, Search) may stay unreachable with
# backoff before the job parks in paused(reason=dependency) and auto-resumes on
# recovery.
# JOB_LEASE_SECONDS=60
# JOB_HEARTBEAT_INTERVAL_MS=20000
# JOB_POLL_INTERVAL_MS=2000
# JOB_MAX_TRANSIENT_WAIT_MS=900000
# Per-page output-token estimate the budget guard checks before a vision call, so
# a job about to exceed its token_budget parks in paused(reason=budget) first.
# VISION_TOKEN_ESTIMATE=4096
#
# A job with more than LARGE_JOB_PAGE_THRESHOLD pages runs in a separate lane,
# with at most LARGE_JOB_MAX_CONCURRENCY such jobs leased across the whole fleet,
# so small uploads never wait days behind a large plan.
# LARGE_JOB_PAGE_THRESHOLD=1000
# LARGE_JOB_MAX_CONCURRENCY=1

# --- Emitter (v2 → Search revision API) ---------------------------------------
# Pages per NDJSON batch, pages between segment commits, and parallel asset
# uploads. A segment is committed as soon as its batches and assets are
# acknowledged, so with visibility=progressive the first SEGMENT_PAGES pages are
# searchable while the rest is still being handed over; smaller means earlier,
# at the price of more commit round-trips. The batch size is frozen per job when
# its first batch is sent. (The v2-backed /v1/ingest drives documents of up to
# 250 pages inline for a synchronous response, whatever SEGMENT_PAGES says.)
# EMIT_BATCH_PAGES=20
# SEGMENT_PAGES=100
# ASSET_UPLOAD_CONCURRENCY=4
# Model-free outline correction at document end; Search re-embeds only the units
# whose section path changed. false emits the streaming outline as-is.
# FINALIZE_PASS=true

# --- Page analysis (v2) -------------------------------------------------------
# Text fast path: a text-only page with usable bbox geometry skips the vision
# call. Pages with more ink outside their text blocks than the ratio fall back
# to vision.
# TEXT_FAST_PATH=true
# TEXT_FAST_PATH_MAX_INK_RATIO=0.04
# Large-format pages are split into overlapping tiles rendered towards
# TILE_TARGET_PIXELS on the long edge, capped at TILE_MAX_PER_PAGE tiles.
# TILE_TARGET_PIXELS=2000
# TILE_OVERLAP_FRACTION=0.1
# TILE_MAX_PER_PAGE=16
# Structured second pass for these figure kinds, only above the area fraction.
# A transcription containing fewer than LABEL_COVERAGE_MIN percent of the
# figure's labels gets a warning and one retry.
# FIGURE_PASS2_KINDS=bpmn,flowchart,ui_mask,technical_drawing,chart,table_image
# FIGURE_PASS2_MIN_AREA=0.02
# LABEL_COVERAGE_MIN=60

# --- Summary text LLM (v2, opt-in) --------------------------------------------
# Without SUMMARY_URL the summary hierarchy is skipped and a job never fails for
# want of it. The URL is the full chat-completions endpoint, used as-is.
# SUMMARY_URL=http://127.0.0.1:8001/v1/chat/completions
# SUMMARY_MODEL=CHANGE_ME
# SUMMARY_API_KEY=CHANGE_ME
# SUMMARY_TIMEOUT_MS=120000
# SUMMARY_TEMPERATURE=0.1
# SUMMARY_MAX_TOKENS=512
# SUMMARY_MAX_RETRIES=3
# SUMMARY_REASONING_EFFORT=low

# --- Source store and resumable upload (v2) -----------------------------------
# Finished sources are stored content-addressed by sha256 on a filesystem
# volume, so identical bytes dedupe and a job can always re-render from the one
# durable copy. Uploads stream through UPLOAD_TMP_DIR first and are only moved
# into SOURCE_STORE_DIR once their whole-file checksum verifies. Both default
# under TEMP_DIR; point them at persistent volumes in production.
# SOURCE_STORE_DIR=/var/lib/atf-extract/sources
# UPLOAD_TMP_DIR=/var/lib/atf-extract/uploads
#
# A v2 upload may instead pull from a caller-supplied source_url. That is the
# same server-side request forgery surface as CALLBACK_ALLOWED_HOSTS and reuses
# its controls, more strictly: link-local and metadata addresses are always
# refused, and so is any host resolving to a private, loopback, CGNAT or ULA
# address, even when it is allowlisted. SOURCE_URL_ALLOWED_HOSTS narrows the
# public hosts further (an entry beginning with a dot matches any subdomain).
# Empty permits any public host; the production gate flags that once the
# database (and thus the v2 upload routes) is enabled.
# SOURCE_URL_ALLOWED_HOSTS=storage.example.com,.blob.example.net
# SOURCE_URL_MAX_BYTES=2147483648
# SOURCE_URL_TIMEOUT_MS=300000

# --- Search ingest (opt-in) ---------------------------------------------------
# Without SEARCH_URL the /v1/ingest route is not mounted at all, and v2 jobs are
# processed but never emitted. With EXTRACT_DATABASE_URL also set, /v1/ingest
# runs as a wrapper around a v2 job.
# SEARCH_URL=http://127.0.0.1:3002
# SEARCH_TOKEN=CHANGE_ME
# SEARCH_CA_CERT_FILE=  # PEM CA bundle trusting a self-signed Search TLS
# SEARCH_COLLECTION=documents
# SEARCH_TIMEOUT_MS=120000

# --- Access -------------------------------------------------------------------
# The development default is deliberately open. The production readiness gate
# refuses to start with these values when NODE_ENV=production.
AUTHN_MODE=disabled
AUTHZ_ENABLED=false
TENANT_ISOLATION_ENABLED=false
# API_TOKEN=CHANGE_ME
# API_TOKEN_NEXT=CHANGE_ME  # rotation twin of API_TOKEN: while both are set,
# either one authenticates; promote NEXT to API_TOKEN once all clients rolled
# over, then unset NEXT (see DEPLOYMENT.md).
# TLS_CERT_FILE=  # + TLS_KEY_FILE: serve HTTPS directly instead of plain HTTP
# TLS_CLIENT_CA_FILE=  # optional: require mTLS client certs chained to this CA
# API_SERVICE_SCOPES=extract.convert,extract.ingest,extract.metrics,extract.admin
# API_SERVICE_TENANT_ID=default
# API_OIDC_ISSUERS=[{"issuer":"https://issuer.example","audience":"atf-extract","scopesClaim":"scopes","tenantClaim":"tenant"}]
# DEFAULT_TENANT_ID=default
# TRUST_PROXY=false
# EXPOSE_ERROR_DETAIL=false

# --- Browser SSO (opt-in via OIDC_ISSUER) -------------------------------------
# Same shape as Search, so one IdP client can serve both.
# OIDC_ISSUER=https://issuer.example/application/o/atf/
# OIDC_CLIENT_ID=CHANGE_ME
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_SESSION_SECRET=CHANGE_ME_at_least_16_chars
# OIDC_SCOPES=openid profile email
# OIDC_REDIRECT_URI=https://extract.example/auth/callback
# Either or both may be set; a session is accepted when it matches one of them.
# Leaving both unset admits every account the IdP authenticates.
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# OIDC_ALLOWED_EMAILS=operator@example.com
# OIDC_GROUPS_CLAIM=groups
# OIDC_SESSION_TTL=28800
# MONITOR_TOKEN=CHANGE_ME

# --- UI backend-for-frontend --------------------------------------------------
# The UI never derives tenant or scopes from the ID token; the server picks them.
# UI_TENANT_ID=default
# UI_SCOPES=extract.convert,extract.ingest
# UI_ALLOWED_GROUPS=atf-operators
# UI_OPERATOR_GROUP=atf-operators
