{
  "name": "@atf/extract",
  "version": "0.12.0",
  "private": true,
  "description": "Document-to-Markdown extraction service: PDF, Word, Excel and image formats to the canonical atf-extract contract, with direct Search ingest",
  "author": "Abillify Technology GmbH <info@abillify.me>",
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "coverage:check": "node scripts/check-coverage.mjs",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "build:node": "bun build ./src/index.ts --outdir ./dist-node --target node --external sharp"
  },
  "engines": {
    "bun": ">=1.4.0 <2",
    "node": ">=26 <27"
  },
  "dependencies": {
    "@atf/extract-contract": "workspace:2.2.0",
    "bmp-js": "0.1.0",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sharp": "0.35.4",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bmp-js": "0.1.2",
    "@types/bun": "1.4.0",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
