# @atf/runtime — orchestration and OpenAI-compatible API.
#
# Complete reference: docs/CONFIGURATION.md (generated from src/config/schema.ts).
# Runtime validates the entire environment at startup and reports every problem at once.
#
# A PROFILE fills a curated bundle of defaults for unset variables; explicit values always win.
# PROFILE=dev | secure | regulated | regulated-multitenant | performance

PORT=3000
APP_ENV=development
LOG_LEVEL=info
FLOWS_DIR=../../deploy/examples/flows

# --- Identity and access -----------------------------------------------------
AUTHN_MODE=disabled
AUTHZ_ENABLED=false
TENANT_ISOLATION_ENABLED=false
CORS_ORIGINS=http://localhost:3001
# JWT_SECRET=CHANGE_ME
# JWT_ISSUER=https://issuer.example
# JWT_AUDIENCE=atf-runtime
# JWT_JWKS_URL=https://issuer.example/.well-known/jwks.json
# JWT_REQUIRE_VERIFICATION=true
# TRUSTED_IDENTITY_HEADERS=
# OPERATOR_ROLE_CLAIM=roles
# OPERATOR_ROLE_MAP={"atf-admin":"admin","atf-ops":"operator"}

# --- Providers and models ----------------------------------------------------
PROVIDERS=[{"name":"local","protocol":"openai","url":"http://127.0.0.1:1234/v1","local":true}]
DEFAULT_LLM={"provider":"local","model":"CHANGE_ME"}
# FALLBACK_LLM={"provider":"local","model":"CHANGE_ME"}
# FALLBACK_CHAIN=[{"provider":"local","model":"CHANGE_ME"}]
# EMBEDDING_MODEL={"provider":"local","model":"CHANGE_ME"}
# LLM_REQUEST_TIMEOUT_MS=120000
# MAX_TOOL_STEPS=10

# --- State -------------------------------------------------------------------
# DATABASE_URL=postgres://CHANGE_ME
# DATABASE_OPERATOR_URL=postgres://CHANGE_ME
# TENANT_RLS_ENABLED=true
# REDIS_URL=redis://127.0.0.1:6379
# CHECKPOINTING_ENABLED=true

# --- Tools and retrieval -----------------------------------------------------
# MCP_SERVERS=[{"name":"gate","url":"http://127.0.0.1:3003/mcp"}]
# RAG_ENABLED=true
# TOOL_AUTHZ_FAIL_CLOSED=true
# TOOL_EGRESS_GUARDRAIL=true
# TOOL_OUTPUT_VALIDATOR_ENABLED=true

# --- Safety ------------------------------------------------------------------
# INPUT_GUARDRAILS_ENABLED=true
# OUTPUT_GUARDRAILS_ENABLED=true
# GROUNDEDNESS_ENABLED=true
# APPROVAL_GATE_ENABLED=true
# APPROVAL_REQUIRE_TOOLS=gate:*_write,gate:*_delete
# APPROVAL_TIMEOUT_MS=300000
# PII_VAULT_ENABLED=true
# PII_VAULT_ENCRYPTION_KEY=CHANGE_ME
# PII_DETECTORS=regex,ner
# PII_DETECTOR_FAIL_MODE=closed
# PII_VAULT_MULTIMODAL_MODE=block
# SANDBOX_ENABLED=true
# PLUGINS_SANDBOX=true

# --- Rocket.Chat channel (optional; requires DATABASE_URL + ASSISTANTS_ENABLED) ----
# Off unless ROCKETCHAT_ENABLED is set. See docs/CAPABILITIES.md#rocketchat.
# ROCKETCHAT_ENABLED=true
# ROCKETCHAT_BASE_URL=https://chat.example.com
# ROCKETCHAT_BOT_USER_ID=
# ROCKETCHAT_BOT_AUTH_TOKEN=CHANGE_ME
# ROCKETCHAT_WEBHOOK_TOKEN=CHANGE_ME_MIN_16_CHARS
# ROCKETCHAT_TIMEOUT_MS=10000
# ROCKETCHAT_SWEEP_INTERVAL_MS=10000

# Self-service linking for unknown conversations. All five are required together,
# and the issuer/client/secret must be IDENTICAL to the ASSISTANT_DELEGATION_*
# values below — otherwise only the webhook is mounted.
# These are read directly and are NOT validated by the startup schema.
# ROCKETCHAT_CONNECT_OIDC_ISSUER=https://idp.example.com
# ROCKETCHAT_CONNECT_OIDC_CLIENT_ID=
# ROCKETCHAT_CONNECT_OIDC_CLIENT_SECRET=CHANGE_ME
# ROCKETCHAT_CONNECT_SESSION_SECRET=CHANGE_ME
# ROCKETCHAT_CONNECT_PUBLIC_URL=https://atf.example.com
# ROCKETCHAT_CONNECT_REQUEST_TTL_SECONDS=900
# ROCKETCHAT_CONNECT_DEFAULT_FLOW_ID=assistant
# ROCKETCHAT_CONNECT_TENANT_ID=

# Delegated background authority (also used by scheduled assistant runs).
# ASSISTANTS_ENABLED=true
# ASSISTANT_ENCRYPTION_KEY=CHANGE_ME
# ASSISTANT_DELEGATION_ISSUER=https://idp.example.com
# ASSISTANT_DELEGATION_CLIENT_ID=
# ASSISTANT_DELEGATION_CLIENT_SECRET=CHANGE_ME

# --- Cost and limits ---------------------------------------------------------
# BUDGET_DAILY_PER_TENANT=50
# COST_ANOMALY_ENABLED=true
# Currency label shown in every cost display: EUR (default), USD, CHF or GBP.
# One fixed currency for the whole system — values are only labelled, never
# converted. Must match the Control's NEXT_PUBLIC_CURRENCY.
# CURRENCY=EUR
# RATE_LIMIT_PER_MINUTE=120
# MAX_CONCURRENT_EXECUTIONS=20
# EXECUTION_TIMEOUT_MS=300000
# RESPONSE_CACHE_ENABLED=true
# SEMANTIC_CACHE_ENABLED=true

# --- Observability -----------------------------------------------------------
MONITORING_AUTH=false
METRICS_AUTH=false
# METRICS_ENABLED=true
# TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=atf-runtime
# MONITORING_TRANSPORT=sse
# AUDIT_ANCHOR_SECRET=CHANGE_ME
# EVIDENCE_BUNDLE_SECRET=CHANGE_ME
# RETENTION_ENABLED=true

# --- Smoke scripts only ------------------------------------------------------
# Used exclusively by scripts/smoke-*.ts and the model integration tests, which talk to
# providers directly. These are NOT Runtime configuration; Runtime reads PROVIDERS.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=
# LMSTUDIO_BASE_URL=
# RUN_MODEL_INTEGRATION=1
