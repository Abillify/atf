    "@ai-sdk/openai": "4.0.110",
    "@ai-sdk/provider": "4.0.36",
    "@atf/canonical-json": "workspace:1.0.1",
    "@atf/evidence-contract": "workspace:1.1.1",
    "@atf/erasure-contract": "workspace:1.0.1",
    "@atf/identity-contract": "workspace:1.2.0",
    "@atf/mcp-2026": "workspace:1.0.0",
    "@atf/observability": "workspace:1.0.0",
    "@atf/schema-compatibility": "workspace:1.0.0",
    "@atf/security-kit": "workspace:1.4.0",
    "@atf/transaction-contract": "workspace:1.1.0",
    "@aws-sdk/client-bedrock-agent-runtime": "3.1164.0",
    "@huggingface/transformers": "4.3.2",
    "@langchain/core": "1.3.5",
    "@langchain/langgraph": "1.7.1",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@modelcontextprotocol/sdk": "1.32.2",
