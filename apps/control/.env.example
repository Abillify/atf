# @atf/control — operator and governance web interface.
#
# Control is a pure client of Runtime's HTTP API and holds no private configuration. It never
# talks to PostgreSQL, Redis, or a model provider directly.

# Runtime's base URL as reached from the BROWSER, not from inside the container. Next.js inlines
# NEXT_PUBLIC_* at build time, so this must be set for `bun run build`, not only at start.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3000

# strict (default) sends a hardened Content-Security-Policy.
# legacy relaxes it and exists for the local quickstart only.
CONTROL_CSP_MODE=strict

NODE_ENV=development
