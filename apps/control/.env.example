# @atf/control — operator and governance web interface.
#
# Control uses Runtime's HTTP API and SSE stream. It never talks to PostgreSQL, Redis, or a
# model provider directly.

# Development without a reverse proxy: Runtime's origin as reached by the BROWSER.
# NEXT_PUBLIC_* is frozen into the browser bundle at build time. Omit this in production and
# route Runtime paths through an external same-origin reverse proxy instead.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:3000

# Display currency for every cost figure in the UI: EUR (default), USD, CHF or GBP.
# The system always works in exactly ONE fixed currency — values are only labelled,
# never converted. Must match the Runtime's CURRENCY variable. NEXT_PUBLIC_* is
# frozen into the browser bundle at build time.
NEXT_PUBLIC_CURRENCY=EUR

# Content-Security-Policy mode: enforce (default), report-only, legacy.
# enforce: emit Content-Security-Policy with a per-request script nonce.
# report-only: emit Content-Security-Policy-Report-Only for rollout observation.
# legacy: no CSP header (pre-0.15 behaviour).
# CONTROL_CSP_MODE=enforce

# Session mode: token (default) or bff.
# token: the browser holds the Access-Token (sessionStorage, current behaviour).
# bff: the Next.js server holds the token server-side only; the browser gets an
# encrypted HttpOnly/SameSite=Strict cookie and all Runtime calls go through the
# same-origin proxy /api/backend/*. An invalid value fails every request.
# CONTROL_SESSION_MODE=token

# Master secret for the sealed session cookie in bff mode (>= 32 characters,
# e.g. `openssl rand -hex 32`). Required with CONTROL_SESSION_MODE=bff: without
# it the session endpoints return 503. Rotating the secret logs everyone out.
# CONTROL_SESSION_SECRET=

# Server-side Runtime origin the BFF proxy forwards to (default
# http://127.0.0.1:3000, or NEXT_PUBLIC_BACKEND_URL). Never sent to the browser.
# CONTROL_BACKEND_URL=http://127.0.0.1:3000

NODE_ENV=development
