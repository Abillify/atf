// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildHybridQuery > snapshots the fused-score SQL for the default weights 1`] = `"WITH vec AS ( SELECT id, 1 - (vector <=> $1::vector(768)) AS vscore FROM "documents" WHERE TRUE AND "documents".is_latest = TRUE AND tenant_id = $5 ORDER BY vector <=> $1::vector(768) LIMIT $4 ), txt AS ( SELECT id, ts_rank_cd(ts_search, to_tsquery('german', $2), 32) AS tscore, (ts_search @@ to_tsquery('german', $3)) AS tall FROM "documents" WHERE TRUE AND "documents".is_latest = TRUE AND tenant_id = $5 AND ts_search @@ to_tsquery('german', $2) ORDER BY tall DESC, tscore DESC LIMIT $4 ), vec_ranked AS ( SELECT id, vscore, ROW_NUMBER() OVER (ORDER BY vscore DESC) AS vrank FROM vec ), txt_ranked AS ( SELECT id, tscore, ROW_NUMBER() OVER (ORDER BY tall DESC, tscore DESC) AS trank FROM txt ), rrf AS ( SELECT COALESCE(v.id, t.id) AS id, COALESCE(v.vscore, 0) AS vector_similarity, COALESCE(t.tscore, 0) AS text_score, NULL::float8 AS sparse_score, COALESCE((1.0 / (60 + v.vrank)), 0) + COALESCE((1.0 / (60 + t.trank)), 0) AS rrf_score FROM vec_ranked v FULL OUTER JOIN txt_ranked t ON v.id = t.id ) SELECT d.id::text, d.reference, d.base_ref, d.content, d.prefix, d.metadata, d.chunk, d.source, d.link, d.title, d.tags, d.created, d.modified, d.valid_from, d.revision_id, COALESCE(d.valid_from, d.created) AS effective_valid_from, r.vector_similarity, r.text_score, r.sparse_score, r.rrf_score FROM rrf r JOIN "documents" d ON d.id = r.id ORDER BY r.rrf_score DESC, d.id ASC LIMIT $6 OFFSET $7"`;

exports[`buildHybridQuery > snapshots the fused-score SQL for the default weights 2`] = `"WITH vec AS ( SELECT id, 1 - (vector <=> $1::vector(768)) AS vscore FROM "documents" WHERE TRUE AND "documents".is_latest = TRUE AND tenant_id = $6 ORDER BY vector <=> $1::vector(768) LIMIT $4 ), txt AS ( SELECT id, ts_rank_cd(ts_search, to_tsquery('german', $2), 32) AS tscore, (ts_search @@ to_tsquery('german', $3)) AS tall FROM "documents" WHERE TRUE AND "documents".is_latest = TRUE AND tenant_id = $6 AND ts_search @@ to_tsquery('german', $2) ORDER BY tall DESC, tscore DESC LIMIT $4 ), spr AS ( SELECT id, (sparse_vector <#> $5::sparsevec(30000)) * -1 AS sprscore FROM "documents" WHERE TRUE AND "documents".is_latest = TRUE AND tenant_id = $6 AND sparse_vector IS NOT NULL ORDER BY sparse_vector <#> $5::sparsevec(30000) LIMIT $4 ), spr_ranked AS ( SELECT id, sprscore, ROW_NUMBER() OVER (ORDER BY sprscore DESC) AS sprrank FROM spr ), vec_ranked AS ( SELECT id, vscore, ROW_NUMBER() OVER (ORDER BY vscore DESC) AS vrank FROM vec ), txt_ranked AS ( SELECT id, tscore, ROW_NUMBER() OVER (ORDER BY tall DESC, tscore DESC) AS trank FROM txt ), rrf AS ( SELECT COALESCE(v.id, t.id, spr.id) AS id, COALESCE(v.vscore, 0) AS vector_similarity, COALESCE(t.tscore, 0) AS text_score, COALESCE(spr.sprscore, 0) AS sparse_score, COALESCE((1.0 / (60 + v.vrank)), 0) + COALESCE((1.0 / (60 + t.trank)), 0) + COALESCE((1.0 / (60 + spr.sprrank)), 0) AS rrf_score FROM vec_ranked v FULL OUTER JOIN txt_ranked t ON v.id = t.id FULL OUTER JOIN spr_ranked spr ON spr.id = COALESCE(v.id, t.id) ) SELECT d.id::text, d.reference, d.base_ref, d.content, d.prefix, d.metadata, d.chunk, d.source, d.link, d.title, d.tags, d.created, d.modified, d.valid_from, d.revision_id, COALESCE(d.valid_from, d.created) AS effective_valid_from, r.vector_similarity, r.text_score, r.sparse_score, r.rrf_score FROM rrf r JOIN "documents" d ON d.id = r.id ORDER BY r.rrf_score DESC, d.id ASC LIMIT $7 OFFSET $8"`;
