# @atf/search — semantic and hybrid retrieval on PostgreSQL/pgvector.
#
# Complete reference: docs/CONFIGURATION.md (generated from src/config.ts).
# Search has its own environment contract. Names that also exist in Runtime are NOT shared.

PORT=3002
NODE_ENV=development
LOG_LEVEL=info
# OTel span export via the shared @atf/observability tracer (log-only without
# an endpoint).
# TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=atf-search

# --- Required ----------------------------------------------------------------
POSTGRES_URL=postgres://CHANGE_ME
EMBED_URL=http://127.0.0.1:8080/v1/embeddings
EMBED_MODEL=CHANGE_ME

# --- Embedding contract ------------------------------------------------------
# EMBED_MODEL_REVISION and EMBED_EXPECTED_DIMENSION make an unsafe in-place model swap fail
# fast instead of silently degrading relevance across an existing index.
EMBED_MODEL_REVISION=CHANGE_ME
EMBED_EXPECTED_DIMENSION=1024
# "input" for OpenAI-compatible servers, "inputs" for TEI. Default: inputs
EMBED_INPUT_FIELD=input
# EMBED_FALLBACK_URL=
# EMBED_FALLBACK_MODEL=
# A fallback model must embed into the SAME vector space as EMBED_MODEL. A
# different name fails startup unless both servers provably serve the same
# underlying model — then assert it explicitly:
# EMBED_FALLBACK_SAME_SPACE=true

# --- Access ------------------------------------------------------------------
AUTHN_MODE=disabled
AUTHZ_ENABLED=false
TENANT_ISOLATION_ENABLED=false
ACL_REQUIRE_IDENTITY=false
# API_TOKEN=CHANGE_ME
# API_TOKEN_NEXT=CHANGE_ME  # rotation twin of API_TOKEN: while both are set,
# either one authenticates; promote NEXT to API_TOKEN once all clients rolled
# over, then unset NEXT (see DEPLOYMENT.md).
# TLS_CERT_FILE=  # + TLS_KEY_FILE: serve HTTPS directly instead of plain HTTP
# TLS_CLIENT_CA_FILE=  # optional: require mTLS client certs chained to this CA
# API_OIDC_ISSUERS=[{"issuer":"https://issuer.example","audience":"atf-search"}]
# API_OIDC_DEFAULT_TENANT_ID=default
# TRUST_PROXY=false

# --- Retrieval quality -------------------------------------------------------
DEFAULT_COLLECTION=documents
# HYBRID_SEARCH=true
# RRF_K=60
# FTS_LANGUAGE=english
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=150
# SEMANTIC_CHUNKING=true
# LATE_CHUNKING_ALPHA=0.5
# RERANK_URL=
# RERANK_MODEL=
# RERANK_ENDPOINT=rerank
# HYDE_URL=
# HYDE_MODEL=
# Hypothetical-document generations are cached per query for this long (0 = off).
# HYDE_CACHE_TTL_SECONDS=600
# Optional model-based question decomposition for retrieve_for_answer /
# POST /v2/retrieve (decomposition: "llm"). Both URL and MODEL must be set;
# without them (or when the model answer is unusable) the rule-based split
# applies. The result cache follows HYDE_CACHE_TTL_SECONDS.
# RETRIEVE_DECOMPOSE_URL=
# RETRIEVE_DECOMPOSE_MODEL=
# RETRIEVE_DECOMPOSE_TOKEN=
# RETRIEVE_DECOMPOSE_TIMEOUT_MS=4000  # 0 = no timeout
# RETRIEVE_DECOMPOSE_MAX_TOKENS=200
# SEARCH_MAX_QUERY_CHARS=400  # longer queries are cut at the last space
# group_by_document keeps at most this many best-scoring chunks per document
# (1-64); a cut document reports truncated and omitted_chunks.
# SEARCH_GROUP_MAX_CHUNKS_PER_DOCUMENT=8
# The MCP search tool returns compact JSON; true restores 2-space indentation.
# SEARCH_MCP_PRETTY_JSON=false
# Ed25519 key (PEM PKCS#8 or base64 32-byte seed) that signs verified evidence
# packs; the public key is served at /.well-known/atf-search-evidence-jwks.json.
# SEARCH_EVIDENCE_SIGNING_KEY=
# A rerank over many candidates runs as parallel batches of this size.
# RERANK_BATCH_SIZE=16
# RERANK_BATCH_CONCURRENCY=2
# Rerank calls in flight across the whole process (0 = unlimited).
# RERANK_GLOBAL_CONCURRENCY=0
# Context expansion of the hits of one search runs at most 8 at a time
# (fixed; not configurable).
# SPARSE_URL=
# SPARSE_MODEL=
# Per-list weights on the RRF terms (> 0). 1.0 everywhere is the unweighted
# ranking. The identifier list joins only when the query carries an identifier.
# RRF_WEIGHT_DENSE=1.0
# RRF_WEIGHT_FTS=1.0
# RRF_WEIGHT_IDENTIFIER=1.0

# --- Token counting ----------------------------------------------------------
# Chunk token counts via TEI /tokenize; the URL is derived from EMBED_URL when
# unset. Disabled automatically for Bedrock, where a character heuristic is used.
# TOKENIZE_ENABLED=true
# TOKENIZE_URL=http://127.0.0.1:8080/tokenize
# TOKENIZE_TIMEOUT_MS=5000
# TOKENIZE_CACHE_SIZE=2048

# --- Contextual embedding header (v2 units) ----------------------------------
# Share of the chunk token budget the header (title, section path, pages, type,
# page summary) may occupy, in (0, 1).
# CONTEXT_HEADER_MAX_FRACTION=0.15
# One SUMMARY_* model call per chunk for a placement sentence. Expensive; needs
# SUMMARY_MODEL. A model failure falls back to the header without the sentence.
# CONTEXTUAL_CHUNK_LLM=false
# With "on", ingest also indexes the document title and section path (weight D)
# into the lexical ts_search column, so a keyword query for a title-only term
# finds the chunk. Applies only to newly ingested chunks; existing rows keep
# their old index until re-ingested. A language migration recompute drops the
# weighting until re-ingestion.
# FTS_CONTEXTUAL_HEADER=off

# With "query", query tokens of at least 10 characters are split against the
# collection's own lexicon (ts_stat over its ts_search column, cached in
# process for one hour) and the matched lexemes join the lexical OR list only;
# the all-terms AND list keeps its exact-match semantics. A query for
# "Revisionsarbeitsplatz" then also finds chunks containing
# "Arbeitsplatz". The lexicon builds asynchronously, so the first query per
# collection runs without splitting; a lexicon build failure disables
# splitting for that collection for 10 minutes.
# FTS_COMPOUND_SPLIT=off

# --- v2 revision ingest ------------------------------------------------------
# The batch worker turns staged NDJSON batches from Extract into embedded,
# searchable units. Off by default; without it revisions stage but never become
# searchable. Run it on at least one replica. INTERVAL 0 stops the loop.
# BATCH_WORKER=false
# BATCH_WORKER_INTERVAL_MS=2000
# BATCH_WORKER_BACKOFF_MS=30000
# Chunks of one batch embedded in parallel; a wake-up drains up to 25 batches.
# BATCH_WORKER_EMBED_CONCURRENCY=4
# An uncommitted revision that is not heartbeated within REVISION_TTL (seconds,
# default 14 days) is reaped by the cleaner every REVISION_TTL_SWEEP_MS
# (0 disables the sweep).
# REVISION_TTL=1209600
# REVISION_TTL_SWEEP_MS=3600000

# ── Document identity: duplicates and version chains ─────────────────────────
# Every v2 ingest registers its source (POST /v2/sources/identify). A pending
# claim makes a concurrent ingest of the same file a duplicate for
# SOURCE_CLAIM_TTL seconds (default 24 h). Near-duplicates are only compared
# within one document (same reference without file extension): from
# DEDUP_NEAR_THRESHOLD (MinHash similarity, default 0.9) a same-version text is
# skipped as a duplicate; without comparable versions only from
# DEDUP_DUPLICATE_SIMILARITY (default 0.97), otherwise it is a new version.
# SOURCE_CLAIM_TTL=86400
# DEDUP_NEAR_THRESHOLD=0.9
# DEDUP_DUPLICATE_SIMILARITY=0.97
# REVISION_BATCH_BODY_LIMIT=50mb

# --- v2 asset store ----------------------------------------------------------
# "postgres" keeps asset bytes in vs_assets; "filesystem" keeps them under
# ASSET_STORE_DIR (required then, use a persistent volume) with metadata still
# in vs_assets.
# ASSET_STORE_BACKEND=postgres
# ASSET_STORE_DIR=/var/lib/atf-search/assets

# --- Index and storage -------------------------------------------------------
# HNSW_M=16
# HNSW_EF_CONSTRUCTION=64
# HNSW_EF_SEARCH=40
# QUANTIZATION=none
# VECTOR_HALF_PRECISION=false
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=30000

# --- Transaction envelope ----------------------------------------------------
TRANSACTION_ENFORCEMENT=off
# TRANSACTION_ISSUER=https://issuer.example
# TRANSACTION_AUDIENCE=atf-search
# TRANSACTION_HS256_SECRET=CHANGE_ME
# Prefer the issuer's public keys over a shared secret (the Runtime serves
# /.well-known/atf-transaction-jwks.json). Both can be set during a migration;
# TRANSACTION_ALGORITHMS then defaults to HS256,ES256,EdDSA. Drop the secret and
# set TRANSACTION_ALGORITHMS=EdDSA once every issuer has switched.
# TRANSACTION_JWKS_URI=https://runtime.example/.well-known/atf-transaction-jwks.json
# TRANSACTION_ALGORITHMS=EdDSA

# --- Document converter (opt-in) ---------------------------------------------
# Enables POST /ingest-file, which accepts a raw PDF/DOC/DOCX/XLS/XLSX or
# PNG/JPEG/GIF/TIFF/BMP/WebP, uploads it to @atf/extract and starts a v2 job
# there (202 with job_id). The job's emitter writes the revision and the figure
# images back through /v2/documents/…/revisions and /v2/assets, so Extract
# needs EXTRACT_DATABASE_URL and this service needs BATCH_WORKER. Without
# CONVERTER_URL the route is not mounted at all. CONVERTER_TOKEN needs
# extract.ingest for the upload and job.
#
# CONVERTER_URL also backs the zoom / full-resolution render-and-cache path
# Search carries no poppler, so it calls @atf/extract's
# POST /v2/render and caches the result as an asset variant. That endpoint is
# gated on the extract.admin scope, so CONVERTER_TOKEN must carry it.
# CONVERTER_URL=http://127.0.0.1:3004
# CONVERTER_TOKEN=CHANGE_ME
# CONVERTER_CA_CERT_FILE=  # PEM CA bundle trusting a self-signed Converter TLS
# A whole document, not a page: conversion runs one vision call per page.
# CONVERTER_TIMEOUT_MS=900000
# CONVERTER_UPLOAD_LIMIT=50mb

# --- Limits ------------------------------------------------------------------
# BODY_LIMIT=10mb
# STREAM_BODY_LIMIT=100mb
# RATE_LIMIT=600
# Running more than one replica? The rate-limit budget is per replica unless
# every replica shares one Redis. Declare the replica count and the Redis URL;
# REPLICAS>1 without RATE_LIMIT_REDIS_URL fails the production gate (ADR 0031).
# REPLICAS=1
# RATE_LIMIT_REDIS_URL=redis://redis:6379
