{
    "name": "@atf/search",
    "version": "0.23.0",
    "private": true,
    "author": "Abillify Technology GmbH <info@abillify.me>",
    "license": "Elastic-2.0",
    "type": "module",
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "migrate": "bun run scripts/migrate.ts",
        "fts:language": "bun run scripts/set-fts-language.ts",
        "test": "node node_modules/vitest/vitest.mjs run",
        "typecheck": "tsc --noEmit",
        "coverage:check": "node scripts/check-coverage.mjs",
        "build": "bun build ./src/index.ts --outdir ./dist --target bun",
        "build:node": "bun build ./src/index.ts --outdir ./dist-node --target node --external sharp"
    },
    "engines": {
        "bun": ">=1.4.4 <2",
        "node": ">=26.12.1 <27"
    },
    "dependencies": {
        "@atf/canonical-json": "workspace:1.0.1",
        "@atf/erasure-contract": "workspace:1.0.1",
        "@atf/extract-contract": "workspace:2.4.1",
        "@atf/mcp-2026": "workspace:1.0.0",
        "@atf/observability": "workspace:1.0.0",
        "@atf/security-kit": "workspace:1.4.0",
        "@atf/transaction-contract": "workspace:1.1.0",
        "@aws-sdk/client-bedrock-runtime": "3.1157.0",
        "@modelcontextprotocol/sdk": "1.32.2",
        "express": "5.3.0",
        "jose": "6.2.13",
        "pg": "8.23.1",
        "pino": "10.4.0",
        "pino-http": "11.0.0",
        "redis": "6.3.0",
        "sharp": "0.35.5",
        "uuid": "14.0.3",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "@types/express": "5.0.6",
        "@types/node": "26.6.5",
        "@types/pg": "8.23.1",
        "@types/supertest": "7.2.1",
        "fast-check": "4.10.2",
        "supertest": "7.3.1",
        "typescript": "7.0.2",
        "vitest": "5.0.5"
    }
}
