{
    "name": "@atf/gate",
    "version": "0.22.0",
    "private": true,
    "author": "Abillify Technology GmbH <info@abillify.me>",
    "license": "Elastic-2.0",
    "type": "module",
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "test": "bun test test/unit test/integration",
        "test:e2e": "MCPGATE_LLM_E2E=1 bun test test/e2e/lmstudio.test.ts",
        "typecheck": "tsc --noEmit",
        "build": "bun build ./src/index.ts --outdir ./dist --target bun --external sqlite3 --external better-sqlite3 --external oracledb --external tedious --external mysql --external mysql2 --external mariadb"
    },
    "engines": {
        "bun": ">=1.4.4 <2",
        "node": ">=26.12.1 <27"
    },
    "dependencies": {
        "@atf/canonical-json": "workspace:1.0.1",
        "@atf/erasure-contract": "workspace:1.0.1",
        "@atf/evidence-contract": "workspace:1.1.1",
        "@atf/identity-contract": "workspace:1.2.0",
        "@atf/mcp-2026": "workspace:1.0.0",
        "@atf/schema-compatibility": "workspace:1.0.0",
        "@atf/security-kit": "workspace:1.4.0",
        "@atf/transaction-contract": "workspace:1.1.0",
        "@aws-sdk/client-bedrock-runtime": "3.1157.0",
        "@modelcontextprotocol/sdk": "1.32.2",
        "cors": "2.8.6",
        "express": "5.3.0",
        "express-rate-limit": "8.7.1",
        "jose": "6.2.13",
        "knex": "3.3.0",
        "mqtt": "5.16.1",
        "mysql2": "3.24.6",
        "pg": "8.23.1",
        "rate-limit-redis": "6.0.2",
        "redis": "6.3.0",
        "yaml": "2.9.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/node": "26.6.5",
        "fast-check": "4.10.2",
        "typescript": "7.0.2"
    }
}
