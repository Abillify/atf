# @atf/gate — governed MCP gateway.
#
# Gate's substantive configuration is YAML, not environment variables. Tools, database
# backends, scopes, and policies live in MCPGATE_CONFIG_DIR. See deploy/examples/gate/config.yaml
# for the shape, and docs/CONFIGURATION.md for this table.

MCPGATE_CONFIG_DIR=../../deploy/examples/gate
MCPGATE_ENV=development
# One explicit operating profile for every ATF service (development | staging |
# production | test). It wins over MCPGATE_ENV / NODE_ENV; an unknown value
# aborts the start instead of silently turning the production gate off.
# ATF_PROFILE=development

# --- Logging -----------------------------------------------------------------
MCPGATE_LOG_LEVEL=info
MCPGATE_LOG_JSON=false
# Comma-separated field paths stripped from logs.
# MCPGATE_LOG_REDACT=password,token,secret

# --- Identity and access -----------------------------------------------------
AUTHN_MODE=disabled
AUTHZ_ENABLED=false
DEFAULT_TENANT_ID=default
# A second accepted issuer alongside the one in the YAML config.
# MCPGATE_AUTH_ADDITIONAL_OIDC_ISSUER=https://issuer.example
# MCPGATE_AUTH_ADDITIONAL_OIDC_AUDIENCE=atf-gate
# MCPGATE_AUTH_ADDITIONAL_OIDC_JWKS_URI=https://issuer.example/.well-known/jwks.json

# --- Tenant isolation --------------------------------------------------------
TENANT_ISOLATION_ENABLED=false
# TENANT_ISOLATION_DEFAULT_TENANT_ID=default
# TENANT_ISOLATION_CLAIM_NAMES=tenant_id,org_id
# TENANT_ISOLATION_ISOLATED_DATABASES=
# TENANT_ISOLATION_SQL_VALIDATION_MODE=strict

# --- Transaction envelope ----------------------------------------------------
# All three are required once enforcement is on.
MCPGATE_TRANSACTION_ENFORCEMENT=off
# MCPGATE_TRANSACTION_ISSUER=https://issuer.example
# MCPGATE_TRANSACTION_AUDIENCE=atf-gate
# MCPGATE_TRANSACTION_HS256_SECRET=CHANGE_ME
# Prefer the issuer's public keys over a shared secret. Set both while migrating
# (all of HS256, RS256, ES256, EdDSA are then accepted), then drop the secret and
# set MCPGATE_TRANSACTION_ALGORITHMS=EdDSA. Give every Gate its own audience.
# MCPGATE_TRANSACTION_JWKS_URI=https://runtime.example/.well-known/atf-transaction-jwks.json
# MCPGATE_TRANSACTION_ALGORITHMS=EdDSA
# Needed only when several replicas must share transaction state.
# MCPGATE_TRANSACTION_REDIS_URL=redis://127.0.0.1:6379

# --- Approvals ---------------------------------------------------------------
# Must match Runtime's approval signing secret.
# MCPGATE_APPROVAL_SECRET=CHANGE_ME
# --- Redaction ---------------------------------------------------------------
# Secret key for the `hash` redaction strategy (HMAC-SHA256); without it the
# digest is an unkeyed SHA-256. Setting it changes the hash values.
# MCPGATE_REDACTION_HASH_SECRET=

# --- MCP schema compatibility ------------------------------------------------
# report logs a mismatch; strict rejects it.
MCP_SCHEMA_COMPATIBILITY_MODE=report

# --- Test-only ---------------------------------------------------------------
# MCPGATE_LLM_E2E=1
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# TEST_TOKEN=
