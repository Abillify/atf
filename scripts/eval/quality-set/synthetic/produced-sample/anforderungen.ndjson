{"type":"page","page":1,"size":{"wPt":595,"hPt":842},"class":"text","blocks":[{"id":"p1-b1","page":1,"source":"text-layer","type":"heading","level":1,"text":"1 Einleitung"},{"id":"p1-b2","page":1,"source":"text-layer","type":"paragraph","text":"Dieses Dokument beschreibt die Anforderungen an die Aktenverwaltunq eines mittelständischen Handelsunternehmens."},{"id":"p1-b3","page":1,"source":"text-layer","type":"heading","level":1,"text":"1.1 Geltungsbereich"},{"id":"p1-b4","page":1,"source":"text-layer","type":"paragraph","text":"Die Anforderungen gelten für alle Standorte und für sämtliche Wareneingänge."}],"assets":[],"warnings":[]}
{"type":"page","page":2,"size":{"wPt":595,"hPt":842},"class":"text","blocks":[{"id":"p2-b1","page":2,"source":"text-layer","type":"heading","level":1,"text":"2 Funktionale Anforderungen"},{"id":"p2-b2","page":2,"source":"text-layer","type":"paragraph","text":"Das System muss Vorgänge und Aktenzeichen verwalten."},{"id":"p2-b3","page":2,"source":"text-layer","type":"heading","level":2,"text":"2.1 Antragseingang"},{"id":"p2-b4","page":2,"source":"text-layer","type":"paragraph","text":"Jeder Antragseingang wird gegen die Bestellung geprüft und gebucht."},{"id":"p2-b5","page":2,"source":"text-layer","type":"paragraph","text":"2.2 Nicht-funktionale Anforderungen"},{"id":"p2-b6","page":2,"source":"text-layer","type":"paragraph","text":"Antwortzeiten über 2 Sekunden sind nicht zulässig."}],"assets":[],"warnings":[]}
